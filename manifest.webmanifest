{
  "name": "Ghisa",
  "short_name": "Ghisa",
  "description": "Tracker per palestra, cardio, dieta e corpo",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1c262b",
  "theme_color": "#1c262b",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "f",
          "accept": [
            ".gpx",
            ".tcx",
            ".kml",
            ".zip",
            ".gz",
            "application/gpx+xml",
            "application/vnd.garmin.tcx+xml",
            "application/vnd.google-earth.kml+xml",
            "application/zip",
            "application/gzip",
            "application/xml",
            "text/xml",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
